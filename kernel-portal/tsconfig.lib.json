{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/ds-entry.ts",
    "src/components/ui/**/*",
    "src/lib/**/*",
    "src/hooks/**/*"
  ]
}
