{
  "$id": "kernel-ds/prototype-registry@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "figma", "initiatives"],
  "properties": {
    "$schema": { "const": "kernel-ds/prototype-registry@1" },
    "version": { "const": 1 },
    "figma": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fileKey", "name"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "initiatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/initiative" }
    }
  },
  "$defs": {
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "date", "actor", "source", "reason", "evidence"],
      "properties": {
        "from": { "type": ["string", "null"], "enum": [null, "exploration", "candidate", "validated", "promoted", "prototype-only"] },
        "to": { "enum": ["exploration", "candidate", "validated", "promoted", "prototype-only"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "actor": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "concern": {
      "type": "object",
      "additionalProperties": true,
      "required": ["concern", "state", "origin", "history"],
      "properties": {
        "concern": { "enum": ["visual", "component", "pattern", "object-model", "workflow", "data"] },
        "state": { "enum": ["exploration", "candidate", "validated", "promoted", "prototype-only"] },
        "origin": { "enum": ["figma", "kernel-app"] },
        "history": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/history" } }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lifecycle", "scopeKey", "entityIds", "surfaces", "concerns"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["active", "superseded", "retired"] },
        "scopeKey": { "type": "string", "pattern": "^[a-z0-9]+(?:[./-][a-z0-9]+)*$" },
        "supersedes": { "type": "array", "items": { "type": "string" } },
        "entityIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["figma", "kernelApp"],
          "properties": {
            "figma": { "type": "array", "items": { "type": "object" } },
            "kernelApp": { "type": "array", "items": { "type": "object" } }
          }
        },
        "concerns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/concern" } }
      }
    }
  }
}
