{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "composite": false,
    "incremental": false,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/__check__.mts", "src/**/__check__.mjs"]
}
