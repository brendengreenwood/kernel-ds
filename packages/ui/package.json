{
  "name": "@kernel/ui",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brendengreenwood/kernel-ds.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "api.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "import": "./dist/marks.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./api.json": "./api.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate-entrypoints.mjs",
    "build": "npm run generate && tsup && node scripts/finalize-build.mjs",
    "check": "node scripts/check-package.mjs",
    "test": "node --test scripts/package.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@formkit/auto-animate": "^0.9.0",
    "@mdi/js": "^7.4.47",
    "@number-flow/react": "^0.6.1",
    "@shadcn/react": "0.2.1",
    "@tanstack/react-table": "^8.21.3",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  }
}
