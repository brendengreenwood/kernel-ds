    {
      "scenarioId": "component.input",
      "entityId": "component.input",
      "route": "/components/input",
      "setup": [
        "Use the labelled email input in the Forms gallery cluster"
      ],
      "steps": [
        {
          "type": "goto",
          "path": "/components/input"
        },
        {
          "type": "assertVisible",
          "selector": "label[for=\"email\"]"
        },
        {
          "type": "assertVisible",
          "selector": "#email"
        },
        {
          "type": "click",
          "selector": "#email"
        },
        {
          "type": "press",
          "selector": "#email",
          "key": "a"
        },
        {
          "type": "assertAttribute",
          "selector": "#email",
          "name": "type",
          "value": "email"
        },
        {
          "type": "screenshot",
          "name": "input"
        }
      ],
      "expectedObservations": [
        "The input is associated with a visible label",
        "The focused input accepts keyboard entry and exposes the entered value"
      ],
      "requiredCaptureName": "input.png"
