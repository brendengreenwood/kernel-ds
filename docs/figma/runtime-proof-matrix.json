    {
      "scenarioId": "component.sidebar",
      "entityId": "component.sidebar",
      "route": "/components/sidebar",
      "setup": [
        "Use the portal shell SidebarProvider and SidebarTrigger"
      ],
      "steps": [
        {
          "type": "goto",
          "path": "/components/sidebar"
        },
        {
          "type": "assertVisible",
          "selector": "[data-sidebar=\"trigger\"]"
        },
        {
          "type": "assertAttribute",
          "selector": "[data-slot=\"sidebar\"]",
          "name": "data-state",
          "value": "expanded"
        },
        {
          "type": "click",
          "selector": "[data-sidebar=\"trigger\"]"
        },
        {
          "type": "assertAttribute",
          "selector": "[data-slot=\"sidebar\"]",
          "name": "data-state",
          "value": "collapsed"
        },
        {
          "type": "screenshot",
          "name": "sidebar"
        }
      ],
      "expectedObservations": [
        "The sidebar trigger has an accessible visible control",
        "Activating the trigger changes the sidebar from expanded to collapsed"
      ],
      "requiredCaptureName": "sidebar.png"
