    {
      "scenarioId": "component.button",
      "entityId": "component.button",
      "route": "/components/button",
      "setup": [
        "Use the rendered Button gallery cluster"
      ],
      "steps": [
        {
          "type": "goto",
          "path": "/components/button"
        },
        {
          "type": "assertVisible",
          "selector": "main"
        },
        {
          "type": "press",
          "selector": "body",
          "key": "Tab"
        },
        {
          "type": "assertVisible",
          "selector": "button:has-text(\"Primary\")"
        },
        {
          "type": "click",
          "selector": "button:has-text(\"Primary\")"
        },
        {
          "type": "screenshot",
          "name": "button"
        }
      ],
      "expectedObservations": [
        "Keyboard traversal reaches an enabled button",
        "Primary action accepts pointer activation without a runtime error"
      ],
      "requiredCaptureName": "button.png"
    },
